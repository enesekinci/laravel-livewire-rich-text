{
    "name": "enesekinci/laravel-livewire-rich-text",
    "description": "TipTap-based rich text editor for Laravel Livewire (wire:ignore + Alpine + wire:model).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livewire", "tiptap", "richtext", "wysiwyg", "editor", "alpine"],
    "authors": [
        {
            "name": "Enes Ekinci",
            "homepage": "https://github.com/enesekinci"
        }
    ],
    "homepage": "https://github.com/enesekinci/laravel-livewire-rich-text",
    "support": {
        "issues": "https://github.com/enesekinci/laravel-livewire-rich-text/issues",
        "source": "https://github.com/enesekinci/laravel-livewire-rich-text"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "EnesEkinci\\RichText\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EnesEkinci\\RichText\\RichTextServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
